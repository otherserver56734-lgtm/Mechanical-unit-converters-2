import { 
  Settings, 
  Copy, 
  Info, 
  RotateCcw, 
  ChevronDown, 
  Check 
} from 'lucide-react';

// ==========================================
// 1. TYPES & INTERFACES
// ==========================================
type System = 'SI' | 'CGS' | 'MKS' | 'Imperial' | 'Other';

interface Unit {
  id: string;
  name: string;
  symbol: string;
  derivedFormula: string;
  system: System;
  toBase: number;
}

interface Category {
  id: string;
  name: string;
  baseUnitName: string;
  units: Unit[];
}

